# Ativa a engine de reescrita do Apache
RewriteEngine On

# 1. Se acessar o diretório /blog ou /blog/, serve o arquivo blog.html da raiz
# Isso corrige o erro 403 Forbidden da pasta blog/
RewriteRule ^blog/?$ blog.html [L]

# 2. Remove index.html da URL (redirecionamento 301)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 3. Remove a extensão .html dos arquivos na barra de endereço (redirecionamento 301)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# 4. Serve internamente o arquivo .html se ele existir no servidor
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

# Cache: o servidor não mandava Cache-Control e navegadores mostravam versão
# antiga da página por horas. HTML e JS/CSS próprios (sem versão no nome)
# sempre revalidam (304 se nada mudou); imagens e fontes ficam 7 dias.
<IfModule mod_headers.c>
	<FilesMatch "\.(html|js|css|xml|txt)$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>
	<FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf)$">
		Header set Cache-Control "public, max-age=604800"
	</FilesMatch>
</IfModule>

# Compressão: o HTML da home tem ~130 KB (CSS inline); com gzip cai para ~25 KB
# no 4G do navegador do Instagram. Dentro de IfModule: sem o módulo, nada muda.
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain text/xml application/xml
</IfModule>
